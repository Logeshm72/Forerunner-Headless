# Forerunner Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Salesforce Configuration
# ============================================
SALESFORCE_USERNAME=your.email@company.com
SALESFORCE_ORG_ALIAS=YourOrgAlias

# ============================================
# Agentia Configuration
# Get these from: agentia workspace list
# ============================================
AGENTIA_AI_WORKSPACE=your-workspace-id-here
AGENTIA_AI_ORG=your-org-id-here

# ============================================
# Copado Configuration
# Get API key from Copado UI → Setup → API Keys
# ============================================
COPADO_API_KEY=your-copado-api-key
COPADO_ORG_URL=https://your-org.salesforce.com
